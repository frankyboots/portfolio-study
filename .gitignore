# root underscore folders are for internal use only, so ignore them
/_*

# Shiller ie_data.xls — not committed (no explicit license on shillerdata.com;
# re-pull fresh each session, vintage-dependent per DATA.md §4/§7).
# Provenance + hash pin: DATA.md §1.
ie_data.xls

# Tool caches (uv env, mypy, pytest, ruff, bytecode) — never committed.
__pycache__/
*.pyc
.venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# matplotlib font cache: pipeline stages point MPLCONFIGDIR at config/,
# where matplotlib writes its fontlist cache — build scratch, not config.
config/fontlist*.json

# web/ build scratch (node deps, Astro build output, build-time staged
# copies of the manifest + committed figure exports — see
# web/scripts/stage-artifacts.mjs; committed exports stay single-sourced
# under artifacts/).
web/node_modules/
web/dist/
web/.astro/
web/public/artifacts/
